{
  "uid": "jobscan-main",
  "title": "JobScan Telemetry",
  "tags": ["jobscan"],
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total Scans",
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(jobscan_scans_total)", "refId": "A" }],
      "options": { "colorMode": "value", "graphMode": "area" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Scams Caught",
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 0 },
      "targets": [{ "expr": "sum(jobscan_scans_total{verdict=\"scam\"})", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "red" } }, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Failed / Timed-out Scans",
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 0 },
      "targets": [{ "expr": "sum(jobscan_scans_total{outcome=~\"failed|timeout\"}) or vector(0)", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" } }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Engine Fallbacks",
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(jobscan_engine_fallbacks_total) or vector(0)", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Avg Analysis Time",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 0 },
      "targets": [
        {
          "expr": "sum(jobscan_scan_analysis_duration_seconds_sum) / sum(jobscan_scan_analysis_duration_seconds_count)",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 2 }, "overrides": [] }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Scan Rate by Verdict (per min)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "targets": [
        { "expr": "sum by (verdict) (rate(jobscan_scans_total[5m])) * 60", "legendFormat": "{{verdict}}", "refId": "A" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "AI Analysis Duration by Engine",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "targets": [
        {
          "expr": "sum by (engine) (rate(jobscan_scan_analysis_duration_seconds_sum[5m])) / sum by (engine) (rate(jobscan_scan_analysis_duration_seconds_count[5m]))",
          "legendFormat": "{{engine}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "HTTP p95 Latency by Route",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le, route) (rate(jobscan_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Requests per Second",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "targets": [
        {
          "expr": "sum by (route) (rate(jobscan_http_request_duration_seconds_count[1m]))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "bargauge",
      "title": "Trust Score Distribution",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 21 },
      "targets": [
        { "expr": "sum by (le) (jobscan_trust_score_bucket)", "legendFormat": "≤ {{le}}", "refId": "A", "format": "heatmap" }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "API Memory (RSS)",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 21 },
      "targets": [{ "expr": "jobscan_process_resident_memory_bytes", "legendFormat": "RSS", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] }
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
